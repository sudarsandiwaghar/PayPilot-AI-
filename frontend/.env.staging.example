# =================================================================
# PayPilot AI Frontend — Staging Configuration (.env.staging)
# =================================================================
# When frontend is served behind the staging Nginx reverse proxy,
# keep VITE_API_BASE_URL empty to use relative /api/ requests.
# If hosting frontend and backend on separate domains/origins,
# set this to the backend staging URL (e.g. https://staging-api.paypilot.example.com).
VITE_API_BASE_URL=
