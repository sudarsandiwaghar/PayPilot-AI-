# ── Application ──────────────────────────────
APP_ENV=development              # development | staging | production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
APP_LOG_LEVEL=DEBUG
APP_SECRET_KEY=change-me-in-production   # Used for HMAC preview tokens

# ── Currency ─────────────────────────────────
DEFAULT_CURRENCY=USD             # ISO 4217 — all seeded products use this
                                 # No currency conversion is performed

# ── Stock ────────────────────────────────────
STOCK_RESERVATION_TTL_MINUTES=15 # How long stock is held for an unpaid order

# ── Checkout ─────────────────────────────────
PREVIEW_TOKEN_TTL_MINUTES=10     # How long a checkout preview token is valid

# ── Database (Restricted Application Role) ────
# Connect using the restricted application role (NOSUPERUSER, NOCREATEDB, NOCREATEROLE)
# Replace <LOCAL_DB_PASSWORD> with your local password placeholder (never commit real credentials)
DATABASE_URL=postgresql+asyncpg://paypilot:<LOCAL_DB_PASSWORD>@localhost:5432/paypilot_dev
TEST_DATABASE_URL=postgresql+asyncpg://paypilot:<LOCAL_DB_PASSWORD>@localhost:5432/paypilot_test
DATABASE_ECHO=true               # Log SQL in dev

# ── PayPal Developer Platform (Free Sandbox at developer.paypal.com) ───
PAYPAL_MODE=sandbox               # sandbox | mock | demo | live (use 'sandbox' for real PayPal tests, 'mock' for offline)
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here   # ⚠️ NEVER commit real secrets to GitHub
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=                # Optional sandbox webhook identifier

# ── Stock Sweep Worker ───────────────────────────────────────────────
STOCK_SWEEP_ENABLED=true
STOCK_SWEEP_INTERVAL_SECONDS=60

# ── AI Shopping Agent / Google Gemini (Free at aistudio.google.com) ──
LLM_PROVIDER=gemini               # gemini | mock (use 'gemini' for real AI, 'mock' for offline testing)
LLM_API_KEY=your_gemini_api_key_here  # ⚠️ NEVER commit real secrets to GitHub
LLM_MODEL=gemini-1.5-flash        # Google Gemini model
LLM_BASE_URL=                     # Optional custom API endpoint URL

# ── CORS ─────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
