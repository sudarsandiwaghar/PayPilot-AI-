# ── Application ──────────────────────────────
APP_ENV=development              # development | staging | production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
APP_LOG_LEVEL=DEBUG
APP_SECRET_KEY=change-me-in-production   # Used for HMAC preview tokens

# ── Currency ─────────────────────────────────
DEFAULT_CURRENCY=USD             # ISO 4217 — all seeded products use this
                                 # No currency conversion is performed

# ── Stock ────────────────────────────────────
STOCK_RESERVATION_TTL_MINUTES=15 # How long stock is held for an unpaid order

# ── Checkout ─────────────────────────────────
PREVIEW_TOKEN_TTL_MINUTES=10     # How long a checkout preview token is valid

# ── Database (Restricted Application Role) ────
# Connect using the restricted application role (NOSUPERUSER, NOCREATEDB, NOCREATEROLE)
# Replace <LOCAL_DB_PASSWORD> with your local password placeholder (never commit real credentials)
DATABASE_URL=postgresql+asyncpg://paypilot:<LOCAL_DB_PASSWORD>@localhost:5432/paypilot_dev
TEST_DATABASE_URL=postgresql+asyncpg://paypilot:<LOCAL_DB_PASSWORD>@localhost:5432/paypilot_test
DATABASE_ECHO=true               # Log SQL in dev

# ── PayPal ───────────────────────────────────
PAYPAL_MODE=mock                  # mock | demo | sandbox | live (mock/demo for synthetic local testing)
PAYPAL_CLIENT_ID=                 # Required if sandbox or live
PAYPAL_CLIENT_SECRET=             # ⚠️  NEVER log or expose; required if sandbox or live
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=               # For webhook signature verification (sandbox/live)

# ── Stock Sweep Worker ───────────────────────
STOCK_SWEEP_ENABLED=true
STOCK_SWEEP_INTERVAL_SECONDS=60

# ── AI Shopping Agent / LLM Provider ──────────
LLM_PROVIDER=mock                # mock | gemini | "" (if empty, agent returns clear error)
LLM_API_KEY=                     # ⚠️  Keep in env, never log or commit
LLM_MODEL=gemini-1.5-flash       # Model identifier
LLM_BASE_URL=                    # Optional custom base URL

# ── CORS ─────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
