# =================================================================
# PayPilot AI — Staging Environment Configuration (.env.staging)
# =================================================================
# Copy this file to .env.staging on your staging host.
# NEVER commit real credentials or secret keys to version control!

# ── Application Environment ──────────────────────────────────────
APP_ENV=staging
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false
APP_LOG_LEVEL=INFO

# ── Security & Cryptographic Tokens ─────────────────────────────
# ⚠️ REQUIRED: Generate a 32+ char cryptographic key using:
#    openssl rand -hex 32
# This key signs HMAC checkout preview tokens to detect price tampering.
APP_SECRET_KEY=<GENERATE_SECURE_RANDOM_SECRET_KEY_32_CHARS>

# ── Currency & Inventory Settings ───────────────────────────────
DEFAULT_CURRENCY=USD
STOCK_RESERVATION_TTL_MINUTES=15
PREVIEW_TOKEN_TTL_MINUTES=10

# ── Database (Restricted Staging Application Role) ───────────────
# Connect using the restricted application role (NOSUPERUSER, NOCREATEDB, NOCREATEROLE).
# Replace <STAGING_DB_PASSWORD> with a strong generated password.
DATABASE_URL=postgresql+asyncpg://paypilot:<STAGING_DB_PASSWORD>@db:5432/paypilot_staging
DATABASE_ECHO=false

# ── External Payment Provider (Explicit Mock Mode) ──────────────
# ⚠️ Staging uses synthetic demo payments. Real PayPal credentials must NOT be used.
# Mock mode simulates order creation, approval, failure, retry, and capture
# without sending external requests or processing real financial transactions.
PAYPAL_MODE=mock
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=

# ── Automated Stock Hold Sweeper Worker ─────────────────────────
STOCK_SWEEP_ENABLED=true
STOCK_SWEEP_INTERVAL_SECONDS=60

# ── AI Shopping Assistant (LLM Provider) ────────────────────────
# Use 'mock' for predictable synthetic recommendations without external API keys,
# or 'gemini' if you provide a staging Gemini API key.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash
LLM_BASE_URL=

# ── CORS (Cross-Origin Resource Sharing) ────────────────────────
# In staging, allow requests from the staging frontend domain or reverse proxy.
# Format: JSON array of strings
CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080","https://staging.paypilot.example.com"]
