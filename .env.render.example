# ==============================================================================
# PayPilot AI — Render Free & Neon Free Staging Environment Template
# ==============================================================================
# For manual configuration in Render Dashboard (Environment tab)
# or reference when setting up your Render Blueprint.
# NEVER commit real credentials or production secrets to Git!

# ── Application Runtime ───────────────────────────────────────────────────────
APP_ENV=staging
APP_HOST=0.0.0.0
APP_DEBUG=false
APP_LOG_LEVEL=INFO

# ── Security & HMAC Preview Tokens ───────────────────────────────────────────
# Generate a 32+ character random secret key (e.g. openssl rand -hex 32)
# If using render.yaml Blueprint, Render generates this automatically.
APP_SECRET_KEY=<GENERATE_SECURE_RANDOM_SECRET_KEY_32_CHARS>

# ── Database Connection (Neon Free PostgreSQL) ────────────────────────────────
# ⚠️ REQUIRED: Obtain your connection string from the Neon Console.
# IMPORTANT: Convert the prefix to 'postgresql+asyncpg://' and ensure 'ssl=require' is present.
# Format: postgresql+asyncpg://[user]:[password]@[endpoint].neon.tech/[dbname]?ssl=require
# Example: postgresql+asyncpg://paypilot_owner:npg_xY123@ep-plain-fog-123456.us-east-2.aws.neon.tech/neondb?ssl=require
DATABASE_URL=postgresql+asyncpg://<NEON_USER>:<NEON_PASSWORD>@<NEON_HOST>/<NEON_DATABASE>?ssl=require
DATABASE_ECHO=false

# ── External Payment Gateway (Explicit Mock Mode) ────────────────────────────
# ⚠️ Staging uses synthetic demo payments. Real PayPal credentials must NOT be used.
PAYPAL_MODE=mock
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=

# ── Stock Hold Sweeper (Neon Free Scale-to-Zero Compatibility) ───────────────
# Sweeper interval set to 600s (10 min) > Neon's 5-minute auto-suspend window.
# This allows Neon compute to sleep for ~5 minutes between sweeps while Render is awake.
# In-flow stock holds are checked and expired on-demand during checkout/payment flows.
STOCK_SWEEP_ENABLED=true
STOCK_SWEEP_INTERVAL_SECONDS=600

# ── AI Shopping Assistant (LLM Provider) ──────────────────────────────────────
# Use 'mock' for deterministic synthetic recommendations without external API keys.
# If you wish to test live Gemini in staging, set LLM_PROVIDER=gemini and provide LLM_API_KEY.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash
LLM_BASE_URL=

# ── CORS (Cross-Origin Resource Sharing) ──────────────────────────────────────
# MUST point to your exact Render Frontend Static Site public URL.
# Replace 'paypilot-frontend' with your actual Render service name if different.
CORS_ORIGINS=["https://paypilot-frontend.onrender.com"]

# ── Container Boot Automations ────────────────────────────────────────────────
AUTO_MIGRATE=true
AUTO_SEED=true
